# ========================================================
# TruthLens AI — Production Environment Variables Template
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection
MONGODB_URI=your_mongodb_connection_string

# Authentication & Security Secrets
JWT_SECRET=your_super_secret_jwt_key
SESSION_SECRET=your_session_secret

# TruthScan Detection API Credentials
TRUTHSCAN_API_KEY=your_truthscan_api_key
TRUTHSCAN_BASE_URL=https://api.truthscan.com

# SMTP Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="TruthLens AI Security" <noreply@truthlens.ai>

# Client & CORS Allowed Origins
CLIENT_URL=https://your-frontend.vercel.app
VITE_API_URL=https://your-backend.onrender.com

# OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
